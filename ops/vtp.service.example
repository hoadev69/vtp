[Unit]
Description=VTP Express API
After=network.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/var/www/vtp
Environment=NODE_ENV=production
Environment=PORT=3001
Environment=DATABASE_PATH=/var/www/vtp/data/history.sqlite
Environment=TRUST_PROXY_HOPS=0
ExecStart=/usr/bin/env node /var/www/vtp/current/server.js
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=30
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/vtp/data

[Install]
WantedBy=multi-user.target